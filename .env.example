# Copy this file to .env and paste your keys. .env is git-ignored, so keys never reach GitHub.
# You only need ONE provider to start; add more to compare models.

# --- Free (no credit card) ---
GEMINI_API_KEY=          # https://aistudio.google.com/apikey
GROQ_API_KEY=            # https://console.groq.com/keys
CEREBRAS_API_KEY=        # https://cloud.cerebras.ai
OPENROUTER_API_KEY=      # https://openrouter.ai/keys  (":free" models, 50 requests/day)
MISTRAL_API_KEY=         # https://console.mistral.ai/api-keys
# Ollama runs on your computer and needs no key: install from https://ollama.com/download

# --- Paid (optional) ---
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# --- Optional: change the model a provider uses (list models: python src/llm.py models --provider NAME)
# GEMINI_MODEL=gemini-3.8-flash
# GROQ_MODEL=openai/gpt-oss-120b
# CEREBRAS_MODEL=qwen-3.8-27b
# OPENROUTER_MODEL=        (default: picks a currently free model; list them with --filter :free)
# MISTRAL_MODEL=mistral-small-latest
# OLLAMA_MODEL=qwen3:8b
# OPENAI_MODEL=
